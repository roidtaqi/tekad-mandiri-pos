{
  "name": "@kastur/sync-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Client synchronization transport and orchestration boundary.",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config ../../vitest.config.ts --project packages packages/sync-client",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@kastur/contracts": "*"
  }
}
