{
  "name": "@kastur/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared visual primitives and design-system boundary.",
  "sideEffects": [
    "./src/index.ts",
    "./src/*.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config ../../vitest.config.ts --project ui",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-tooltip": "1.2.16",
    "lucide-react": "1.31.0"
  },
  "peerDependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
