{
  "name": "@kastur/local-db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Dexie-backed local persistence boundary for Kastur clients.",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config ../../vitest.config.ts --project local-db",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@kastur/numeric": "^0.0.0",
    "dexie": "^4.4.5"
  },
  "devDependencies": {
    "@kastur/contracts": "*",
    "fake-indexeddb": "6.2.5"
  }
}
