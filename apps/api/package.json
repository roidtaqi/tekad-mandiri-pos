{
  "name": "@kastur/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "dev": "wrangler dev --local --config wrangler.jsonc",
    "test": "vitest run --config ../../vitest.config.ts --project api",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "types:check": "wrangler types worker-configuration.d.ts --check --config wrangler.jsonc",
    "types:generate": "wrangler types worker-configuration.d.ts --config wrangler.jsonc"
  },
  "dependencies": {
    "@kastur/contracts": "*"
  }
}
