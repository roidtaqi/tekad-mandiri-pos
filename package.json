{
  "name": "kastur-retail-system",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0",
    "npm": ">=9.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "api:smoke": "node tooling/scripts/smoke-api-worker.mjs",
    "api:types": "npm run types:generate --workspace @kastur/api",
    "api:types:check": "npm run types:check --workspace @kastur/api",
    "auth:offline-key:generate": "node tooling/scripts/generate-offline-authorization-key.mjs",
    "bootstrap": "node database/scripts/bootstrap-business.mjs --confirm-create",
    "build": "npm run build --workspaces && node tooling/scripts/verify-build-output.mjs",
    "check:boundaries": "vitest run --config vitest.config.ts --project repository-boundaries",
    "db:migrate": "node database/scripts/migrations.mjs apply",
    "db:migrate:check": "node database/scripts/migrations.mjs check",
    "db:migrate:status": "node database/scripts/migrations.mjs status",
    "db:business:bootstrap": "node database/scripts/bootstrap-business.mjs",
    "db:session:issue": "node database/scripts/issue-session.mjs",
    "dev": "node tooling/scripts/dev-all.mjs",
    "dev:api": "npm run dev --workspace @kastur/api",
    "dev:backoffice": "npm run dev --workspace @kastur/backoffice",
    "dev:pos": "npm run dev --workspace @kastur/pos",
    "dev:ui": "npm run dev:ui --workspace @kastur/backoffice --",
    "start:api": "npm run start --workspace @kastur/api",
    "start:backoffice": "npm run start --workspace @kastur/backoffice",
    "start:pos": "npm run start --workspace @kastur/pos",
    "lint": "oxlint --config .oxlintrc.json --deny-warnings .",
    "migration:dry-run": "node tooling/migration/dry-run.mjs",
    "migration:staging-import": "node tooling/migration/staging-import.mjs",
    "migration:test": "node --test tooling/migration/tests/*.test.mjs",
    "migration:typecheck": "tsc -p tooling/migration/tsconfig.json --noEmit",
    "staging:readiness": "node tooling/migration/staging-readiness.mjs",
    "test": "vitest run --config vitest.config.ts && npm run migration:test",
    "test:database": "node database/scripts/require-test-database.mjs && vitest run --config vitest.config.ts --project database-integration",
    "test:local-db": "npm run test --workspace @kastur/local-db",
    "test:ui": "vitest run --config vitest.config.ts --project ui",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p database/tsconfig.json --noEmit && npm run migration:typecheck && npm run typecheck --workspaces"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.4",
    "@types/node": "^22.20.1",
    "@types/pg": "8.21.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "happy-dom": "20.11.2",
    "oxlint": "^1.78.0",
    "pg": "8.23.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "wrangler": "4.123.0"
  }
}
